# Supabase — Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Supabase — Project Settings > API > Service role key (server-only, NEVER expose to client)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Prisma — Project Settings > Database > Connection string
# Use direct connection with connection_limit=1 for serverless (Vercel)
DATABASE_URL=postgresql://postgres:your-password@db.your-project-ref.supabase.co:5432/postgres?connection_limit=1
DIRECT_URL=postgresql://postgres:your-password@db.your-project-ref.supabase.co:5432/postgres
